# Copy to .env and fill in. NEVER commit .env. Nothing here is ever sent to the browser.

# ---- core ----
PORT=3000
NODE_ENV=production                 # production => secure cookies + AUTH_SECRET is mandatory
AUTH_SECRET=change-me-to-64-random-chars   # generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PUBLIC_URL=https://your-gym.example # used in email links + payment redirect URLs
TRUST_PROXY=1                       # set when running behind nginx / a load balancer (so rate limiting sees real IPs)

# ---- database (SQLite file; the "DATABASE_URL" of this build) ----
DB_PATH=./data/iron-lab.db

# ---- first run ----
SEED_DEMO=false                     # true = demo members/trainers/classes (development only!)
ADMIN_EMAIL=owner@your-gym.example  # used when SEED_DEMO=false
ADMIN_PASSWORD=                     # optional; if empty a random one is printed once at first start

# ---- payments ----
PAYMENT_PROVIDER=mock               # mock = NO real money moves (dev). Use "stripe" for real payments.
STRIPE_SECRET_KEY=                  # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=              # whsec_...  (endpoint: POST {PUBLIC_URL}/api/payments/webhook)

# ---- email ----
RESEND_API_KEY=                     # empty => emails are printed to the server console, not sent
EMAIL_FROM="Iron Lab <no-reply@your-gym.example>"

# ---- SMS / WhatsApp (not implemented: hook in server/lib.js sendSms) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ---- tests only (leave unset in production) ----
# RATE_LIMIT_MULTIPLIER=100
